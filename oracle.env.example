# scribe oracle configuration — copy to oracle.env next to the binary.
# Loaded at startup; real environment variables take precedence.
#
# Option A: Grok subscription (no API key). Copy the riddle-auth.json made by
# `riddle-login grok` (from the riddle project) next to the scribe binary as
# scribe-auth.json (or keep the riddle name — both are found). Nothing to set
# here unless you want to override the model:
#SCRIBE_GROK_MODEL=grok-4.3

# Option B: any OpenAI-compatible API key (must be a vision model).
#SCRIBE_OPENAI_KEY=sk-...
#SCRIBE_OPENAI_BASE=https://api.openai.com/v1
#SCRIBE_OPENAI_MODEL=gpt-4o-mini

# Force a backend instead of auto-picking: openai | grok
#SCRIBE_ORACLE=grok

# Tuning
#SCRIBE_HOLD_MS=900        # how long to hold the pen to trigger
#SCRIBE_ZONE_Y=1435        # top of the command zone (screen px; page is 1872 tall)
#SCRIBE_TEXT_PX=112        # reply handwriting size
#SCRIBE_INK_PPS=570        # writing animation speed (points/second)
#SCRIBE_MAX_TOKENS=1200
#SCRIBE_REASONING=low      # reasoning_effort for thinking models; omit otherwise
#SCRIBE_FONT=/home/root/scribe/MyFont.ttf   # override the reply hand
#SCRIBE_DEBUG_PEN=1        # log the first 60 pen samples (raw + mapped)
